# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=airgapped_search
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=airgapped_search

# Vector Database
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Application
API_HOST=0.0.0.0
API_PORT=8001
SECRET_KEY=generate_a_secure_random_key_here
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# Embedding Configuration
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# File Upload
MAX_UPLOAD_SIZE_MB=100
UPLOAD_DIR=/tmp/uploads

# OCR Configuration (DeepSeek-OCR for scanned documents and images)
ENABLE_OCR=true
OCR_DEVICE=auto  # Options: auto, cuda (NVIDIA GPU), cpu, mps (Apple Silicon)
OCR_BATCH_SIZE=4  # Number of images to process in parallel

# Environment
ENVIRONMENT=development
